        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0431,
            0.3529,
            0.2157
          ],
          "hex": "#0b5a37"
        }
      }
    },
    "warning": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.4353,
