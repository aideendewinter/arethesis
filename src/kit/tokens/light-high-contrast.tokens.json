{
  "$description": "High-contrast overrides for the light theme (WCAG AAA text contrast). Applied on top of light.tokens.json.",
  "color": {
    "$type": "color",
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4196,
          0.4471,
          0.502
        ],
        "hex": "#6b7280"
      }
    },
    "text": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0,
            0.0,
            0.0
          ],
          "hex": "#000000"
        }
      },
      "muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1843,
            0.2078,
            0.2588
          ],
          "hex": "#2f3542"
        }
      }
    },
    "accent": {
      "$root": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2078,
            0.1451,
            0.7216
          ],
          "hex": "#3525b8"
        }
      },
      "hover": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.1647,
            0.1137,
            0.5882
          ],
          "hex": "#2a1d96"
        }
